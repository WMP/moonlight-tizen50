<?xml version="1.0" encoding="UTF-8"?>
<!-- Web UI app of Moonlight: the launchable app that appears in the TV app bar.
     It runs moonlight-tizen's web front-end, with the native transport swapped to
     the Tizen message port (mlbridge.js), talking to the native engine host.
     NOTE: a Tizen WEB package id must be 10 alphanumeric characters (no dots) —
     unlike native/.NET packages, which allow reverse-domain ids. The <tizen:app-control>
     element is intentionally omitted: a plain launchable UI needs only <content>,
     and an app-control without a <tizen:operation> child fails the WRT parser. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://moonlight.stream/tizen5/Moonlight" version="0.0.1" viewmodes="maximized">
  <tizen:application id="Moonlight5.ui" package="Moonlight5" required_version="5.0"/>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <name>Moonlight</name>
  <tizen:profile name="tv"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/messageport"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/mediastorage"/>
</widget>
