<?xml version="1.0" encoding="utf-8"?>
<!-- dev-cert path, Tizen 4.0-5.5 (api-version="4"); type="dotnet".
     Use PUBLIC privileges only - extra privileges force Partner signing, which
     recent 4/5 TVs reject at install. The engine is loaded from memory, not from
     a file in the app folder. -->
<manifest xmlns="http://tizen.org/ns/packages" api-version="4" package="org.moonlight.host" version="0.0.1">
    <profile name="tv"/>
    <!-- service-application: runs in the background, so it stays alive while the
         web UI (Moonlight5.ui) is in the foreground. -->
    <service-application appid="org.moonlight.host.app" exec="MoonlightHost.dll" type="dotnet"
                         auto-restart="false" on-boot="false" taskmanage="false" multiple="false">
        <label>Moonlight host</label>
        <icon>icon.png</icon>
        <!-- keeps running while the web UI is in front -->
        <metadata key="http://samsung.com/tv/metadata/background.execution.support" value="true"/>
        <!-- in the hybrid package (pkg/build-hybrid.sh) the TV reads the app
             metadata from the web part -->
        <metadata key="http://samsung.com/tv/metadata/application/read.metadata.from.hybrid.webapp"/>
    </service-application>
    <privileges>
        <privilege>http://tizen.org/privilege/internet</privilege>
        <privilege>http://tizen.org/privilege/network.get</privilege>
    </privileges>
</manifest>
