diff --git a/pkg/roottest/README.md b/pkg/roottest/README.md
new file mode 100644
index 0000000..a825d06
--- /dev/null
+++ b/pkg/roottest/README.md
@@ -0,0 +1,17 @@
+# roottest — on-device install probe (diagnostic)
+
+`ml_probe.c` is a minimal native `capp` that logs its uid/SMACK and sleeps — used to
+test whether the TV installs + launchpad-starts a hand-assembled native `.tpk`.
+
+## ⚠️ Key finding (2026-11-02): do NOT `pkgcmd -i` an unsigned `.tpk` on the TV
+
+Installing an unsigned `.tpk` via `pkgcmd -i` made `tpk-backend` call into
+**TrustZone** for signature/UEP verification; that call hung, leaving `tpk-backend`
+in **D-state (unkillable)** holding the pkgmgr lock and wedging the secure-world RPC
+threads (`nsrpc`, `tzdev`, `tzlogd`). Load climbed to ~27 — the same signature that
+preceded an earlier freeze needing a power-cycle. `pkginfo --imd` is "Not supported"
+and the app user is **uid 5001**.
+
+**Therefore:** the root install path must NOT use pkgmgr/pkgcmd with an unsigned
+package. Reuse an already-registered package's dir (e.g. `ChqHQExU28`, the NaCl
+Moonlight), or sign properly for the dev-cert path. See `../../docs/BACKPORT.md`.
diff --git a/pkg/roottest/ml_probe.c b/pkg/roottest/ml_probe.c
new file mode 100644
index 0000000..70f088a
--- /dev/null
+++ b/pkg/roottest/ml_probe.c
@@ -0,0 +1,19 @@
+/* Minimal native capp probe: prove the TV installs + launchpad starts a
+ * hand-assembled dev/unsigned capp .tpk (root sideload). Logs who we run as. */
+#include <stdio.h>
+#include <unistd.h>
+#include <time.h>
+int main(int argc, char **argv) {
+    FILE *f = fopen("/tmp/ml_probe.log", "a");
+    time_t t = time(0);
+    char lbl[256] = ""; FILE *s = fopen("/proc/self/attr/current", "r");
+    if (s) { if (!fgets(lbl, sizeof lbl, s)) lbl[0]=0; fclose(s); }
+    char line[512];
+    int n = snprintf(line, sizeof line,
+        "ml_probe START %.24s pid=%d uid=%d gid=%d argv0=%s smack=[%s]\n",
+        ctime(&t), getpid(), getuid(), getgid(), argv[0], lbl);
+    if (f) { fwrite(line, 1, n, f); fclose(f); }
+    fwrite(line, 1, n, stdout); fflush(stdout);
+    sleep(30);           /* stay alive so launchpad sees a live process */
+    return 0;
+}
